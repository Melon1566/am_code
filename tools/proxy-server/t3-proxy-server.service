[Unit]
Description=T3 provider HTTPS forward proxy
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/t3-proxy-server
EnvironmentFile=/etc/t3-proxy-server.env
ExecStart=/opt/t3-proxy-server/start.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=64
LimitNOFILE=2048
StandardOutput=journal
StandardError=journal
SyslogIdentifier=t3-proxy-server
LogRateLimitIntervalSec=30
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
