# Loopback by default. Use 0.0.0.0 for direct access through an EC2 security group.
T3_PROXY_HOST=127.0.0.1
T3_PROXY_PORT=3128

# Exact hostnames only. The service permits CONNECT to these hosts on port 443.
T3_PROXY_ALLOWED_HOSTS=auth.openai.com,api.openai.com,chatgpt.com,api.anthropic.com,claude.ai,platform.claude.com,console.anthropic.com
T3_PROXY_ALLOWED_PORTS=443
T3_PROXY_MAX_CONNECTIONS=256
T3_PROXY_CONNECT_TIMEOUT_MS=10000
T3_PROXY_IDLE_TIMEOUT_MS=600000
